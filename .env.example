# Kopier denne filen til .env og fyll inn egne verdier.
# Lag en ny nøkkel med:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=bytt-meg
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Kun i produksjon, f.eks. https://brukernavn.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=
